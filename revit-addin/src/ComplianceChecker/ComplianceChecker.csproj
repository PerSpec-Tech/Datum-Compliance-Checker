<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2026 add-in (D16). Thin layer over ComplianceChecker.Core: ribbon, Revit export,
       Extensible Storage, WPF UI. Revit API assemblies come from NuGet and are NOT copied to the
       output (Revit loads its own). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ComplianceChecker</RootNamespace>
    <AssemblyName>ComplianceChecker</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComplianceChecker.Core\ComplianceChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ComplianceChecker.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

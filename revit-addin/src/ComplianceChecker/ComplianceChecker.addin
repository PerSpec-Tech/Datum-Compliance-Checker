<?xml version="1.0" encoding="utf-8"?>
<!-- Installed as %AppData%\Autodesk\Revit\Addins\2026\ComplianceChecker.addin, with the DLLs in the
     ComplianceChecker\ folder next to it (see install\install.ps1). -->

<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2026 plug-in (P11, D35). A thin layer over ComplianceChecker.Core: ribbon, commands,
       palettes. The drawing is sent to the server as DXF and read there by the same reader as the
       web app, so AutoCAD and the browser always agree. AutoCAD assemblies come from the
       AutoCAD.NET reference package and are NOT copied to the output (AutoCAD loads its own). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ComplianceChecker.AutoCAD</RootNamespace>
    <AssemblyName>ComplianceChecker.AutoCAD</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD 2026 = release 25.1 -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\revit-addin\src\ComplianceChecker.Core\ComplianceChecker.Core.csproj" />
  </ItemGroup>

  <!-- Shared with the Revit add-in: one pairing token for both (%AppData%\ComplianceChecker). -->
  <ItemGroup>
    <Compile Include="..\..\..\revit-addin\src\ComplianceChecker\Storage\AddinSettings.cs" Link="Shared\AddinSettings.cs" />
    <Compile Include="..\..\..\revit-addin\src\ComplianceChecker\UI\PairWindow.cs" Link="Shared\PairWindow.cs" />
  </ItemGroup>

</Project>

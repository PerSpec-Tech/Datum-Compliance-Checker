  "components": {
    "schemas": {
      "CompileRequest": {
        "properties": {
          "clause_text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 20,
            "title": "Clause Text"
          },
          "clause_ref": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Clause Ref"
          },
          "source": {
            "type": "string",
            "maxLength": 300,
            "title": "Source",
            "default": "pasted by user"
          },
          "authority": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "title": "Authority",
            "default": "udcpr2020"
          },
          "review": {
            "type": "boolean",
            "title": "Review",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "clause_text",
          "clause_ref"
        ],
        "title": "CompileRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewProject"
      },
      "PairComplete": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          },
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "PairComplete"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

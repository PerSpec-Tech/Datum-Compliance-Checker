{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckReport",
  "description": "Result of one compliance check job (ROADMAP §5.4). Pass/fail comes only from engine/evaluate.py; agents only add wording (explanation) and freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "model_version", "ruleset_version", "created_at", "summary", "results", "questions", "explanation", "fsi"],
  "properties": {
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "model_version": { "type": "string", "description": "Id of the BuildingModel version that was checked." },
    "ruleset_version": { "type": "string", "description": "Hash of all rule and table files used." },
    "created_at": { "type": "string", "format": "date-time" },
    "summary": { "$ref": "#/definitions/Summary" },
    "results": { "type": "array", "items": { "$ref": "#/definitions/Result" } },
    "questions": { "type": "array", "items": { "$ref": "#/definitions/Question" } },
    "explanation": { "type": ["string", "null"], "description": "Plain-language summary from the explainer agent (P3.8)." },
    "fsi": { "anyOf": [{ "$ref": "#/definitions/FsiSummary" }, { "type": "null" }] }
  },
  "definitions": {
    "Status": {
      "type": "string",
      "enum": ["pass", "fail", "unverifiable", "not_applicable", "advisory"]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unverifiable", "not_applicable", "advisory"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unverifiable": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "advisory": { "type": "integer", "minimum": 0 }
      }
    },
    "Scalar": { "type": ["number", "string", "boolean", "null"] },
    "FactUsed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "source"],
      "properties": {
        "path": { "type": "string", "description": "e.g. 'site.edges[e2].road_width_m'." },
        "value": { "description": "The value that was read (any JSON)." },
        "source": { "$ref": "common.schema.json#/definitions/Source" }
      }
    },
    "FixDirection": { "type": "string", "enum": ["increase", "decrease"] },
    "FixBy": {
      "description": "How much the measured value must change to pass (D30). Only for comparison failures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit", "direction"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "unit": { "type": ["string", "null"] },
        "direction": { "$ref": "#/definitions/FixDirection" }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "title", "severity", "element", "status", "measured", "limit", "message", "missing_inputs", "facts_used", "clause", "rule_status", "freshness", "fix_by"],
      "properties": {
        "rule_id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
        "element": { "anyOf": [{ "$ref": "common.schema.json#/definitions/ElementRef" }, { "type": "null" }] },
        "status": { "$ref": "#/definitions/Status" },
        "measured": { "$ref": "#/definitions/Scalar" },
        "limit": { "$ref": "#/definitions/Scalar" },
        "message": { "type": "string" },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "facts_used": { "type": "array", "items": { "$ref": "#/definitions/FactUsed" } },
        "clause": { "$ref": "common.schema.json#/definitions/Clause" },
        "rule_status": { "type": "string", "enum": ["draft", "verified"] },
        "freshness": { "$ref": "common.schema.json#/definitions/Freshness" },
        "fix_by": { "anyOf": [{ "$ref": "#/definitions/FixBy" }, { "type": "null" }] },
        "guidance_note": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "source"],
              "properties": { "text": { "type": "string" }, "source": { "type": "string" } }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "InputType": { "type": "string", "enum": ["number", "enum", "bool", "latlon", "edge_tags", "text"] },
    "Question": {
      "description": "A missing input, ranked by how many checks it unlocks (P2.5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "prompt", "unlocks", "rule_ids", "input_type", "options"],
      "properties": {
        "path": { "type": "string" },
        "prompt": { "type": "string" },
        "unlocks": { "type": "integer", "minimum": 0 },
        "rule_ids": { "type": "array", "items": { "type": "string" } },
        "input_type": { "$ref": "#/definitions/InputType" },
        "options": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "FsiSummary": {
      "description": "FSI used vs permitted, built only from rule-table limits (P2.8, D30). Numbers are null when inputs are missing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_area_m2", "built_up_m2", "used", "base_permissible", "max_permissible", "basis", "headroom_base_m2", "headroom_max_m2", "rule_ids", "missing_inputs"],
      "properties": {
        "plot_area_m2": { "type": ["number", "null"] },
        "built_up_m2": { "type": ["number", "null"] },
        "used": { "type": ["number", "null"] },
        "base_permissible": { "type": ["number", "null"] },
        "max_permissible": { "type": ["number", "null"] },
        "basis": { "type": "array", "items": { "type": "string" } },
        "headroom_base_m2": { "type": ["number", "null"], "description": "Negative = over the limit." },
        "headroom_max_m2": { "type": ["number", "null"] },
        "rule_ids": { "type": "array", "items": { "type": "string" } },
        "missing_inputs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
